# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_VIDEO=gpt-4.1-mini
OPENAI_MODEL_QUESTION=gpt-4.1-mini

# Google Drive — set ONE of these two auth methods:
#
# Option A: the folder is public ("Anyone with the link"). Just a Drive-enabled
# API key from Google Cloud Console (APIs & Services > Credentials), no sharing needed.
# NOTE: question posts always need Option B — the Google Forms API doesn't
# support API-key auth.
GOOGLE_API_KEY=
#
# Option B: the folder is private (or you're using question posts). A service
# account key file. Share every folder below — and, for the questions folder,
# also the individual form files inside it — with the service account's
# client_email.
GOOGLE_SERVICE_ACCOUNT_FILE=

DRIVE_FOLDER_ID=
DRIVE_FOLDER_ID_VIDEO=
DRIVE_FOLDER_ID_QUESTIONS=

# Facebook Page
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0

# Used to date the post-generation prompt
TIMEZONE=Asia/Jerusalem

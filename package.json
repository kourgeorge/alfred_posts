{
  "name": "alfred-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "npm run build && playwright test",
    "test:gateway": "node --test tests/gateway.test.js tests/models.test.js tests/telegram.test.js",
    "telegram:setup": "node scripts/telegram_setup.mjs",
    "build:cloudflare": "vite build && node scripts/cloudflare-config.mjs",
    "test:server": "node --test tests/server/*.test.js",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vite": "^7.3.1",
    "wrangler": "^4.147.0"
  }
}
